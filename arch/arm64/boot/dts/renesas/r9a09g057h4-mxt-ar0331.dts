/dts-v1/;
#include "rzv2h-evk-ver1.dts"

/ {
	/delete-node/ 1p8v;
	/delete-node/ 2p8v;
	/delete-node/ 1p5v;
		
	cam1_1v8_supply: 1p8v {
		compatible = "regulator-fixed";
		regulator-name = "cam1_1v8_supply";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	cam1_2v7_supply: 2p7v {
		compatible = "regulator-fixed";
		regulator-name = "cam1_2v7_supply";
		regulator-min-microvolt = <2700000>;
		regulator-max-microvolt = <2700000>;
		regulator-always-on;
	};

	cam1_1v2_supply: 1p2v {
		compatible = "regulator-fixed";
		regulator-name = "cam1_1v2_supply";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		regulator-always-on;
	};

	clk_ext_camera: clk_ext_camera {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};
};
&csi20 {
	status = "okay";

	ports {
		port {
			csi20_in: endpoint {
				clock-lanes = <0>;
				data-lanes = <1>;
				remote-endpoint = <&ar_to_csi20>;
			};
		};
	};
};

&csi21 {
	status = "okay";

	ports {
		port {
			csi21_in: endpoint {
				clock-lanes = <0>;
				data-lanes = <1>;
				remote-endpoint = <&ar_to_csi21>;
			};
		};
	};
};

&csi22 {
	status = "okay";

	ports {
		port {
			csi22_in: endpoint {
				clock-lanes = <0>;
				data-lanes = <1>;
				remote-endpoint = <&ar_to_csi22>;
			};
		};
	};
};

&csi23 {
	status = "okay";

	ports {
		port {
			csi23_in: endpoint {
				clock-lanes = <0>;
				data-lanes = <1>;
				remote-endpoint = <&ar_to_csi23>;
			};
		};
	};
};

&i2c0 {
	pinctrl-0 = <&i2c0_pins>;
	pinctrl-names = "default";

	status = "okay";
	
	ar0331_csi20: ar0331_csi20@10 {
		compatible = "aptina,ar0331";
		reg = <0x10>;
		clock-names = "xclk";
		clocks = <&clk_ext_camera>;
		clock-frequency = <24000000>;
		vana-supply = <&cam1_2v7_supply>;
		vdig-supply = <&cam1_1v2_supply>;
		vif-supply = <&cam1_1v8_supply>;
		
		/* Set dummy enable gpio */
		enable-gpios = <&pinctrl RZV2H_GPIO(1, 6) GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pinctrl RZV2H_GPIO(6, 4) GPIO_ACTIVE_LOW>;

		port {
			ar_to_csi20: endpoint {
				clock-lanes = <0>;
				data-lanes = <1>;
				remote-endpoint = <&csi20_in>;
			};
		};
	};
	
	/delete-node/ ov5645_csi20@3c;
};

&i2c1 {
	pinctrl-0 = <&i2c1_pins>;
	pinctrl-names = "default";

	status = "okay";
	
	ar0331_csi21: ar0331_csi21@10 {
		compatible = "aptina,ar0331";
		reg = <0x10>;
		clock-names = "xclk";
		clocks = <&clk_ext_camera>;
		clock-frequency = <24000000>;
		vana-supply = <&cam1_2v7_supply>;
		vdig-supply = <&cam1_1v2_supply>;
		vif-supply = <&cam1_1v8_supply>;
		
		/* Set dummy enable gpio */
		enable-gpios = <&pinctrl RZV2H_GPIO(1, 7) GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pinctrl RZV2H_GPIO(6, 5) GPIO_ACTIVE_LOW>;

		port {
			ar_to_csi21: endpoint {
				clock-lanes = <0>;
				data-lanes = <1>;
				remote-endpoint = <&csi21_in>;
			};
		};
	};
	
	/delete-node/ ov5645_csi21@3c;
};

&i2c6 {
	pinctrl-0 = <&i2c6_pins>;
	pinctrl-names = "default";

	status = "okay";
	
	ar0331_csi22: ar0331_csi22@10 {
		compatible = "aptina,ar0331";
		reg = <0x10>;
		clock-names = "xclk";
		clocks = <&clk_ext_camera>;
		clock-frequency = <24000000>;
		vana-supply = <&cam1_2v7_supply>;
		vdig-supply = <&cam1_1v2_supply>;
		vif-supply = <&cam1_1v8_supply>;
		
		enable-gpios = <&pinctrl RZV2H_GPIO(6, 1) GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pinctrl RZV2H_GPIO(9, 2) GPIO_ACTIVE_LOW>;

		port {
			ar_to_csi22: endpoint {
				clock-lanes = <0>;
				data-lanes = <1>;
				remote-endpoint = <&csi22_in>;
			};
		};
	};
	
	/delete-node/ ov5645_csi22@3c;
};

&i2c7 {
	pinctrl-0 = <&i2c7_pins>;
	pinctrl-names = "default";

	status = "okay";
	
	ar0331_csi23: ar0331_csi23@10 {
		compatible = "aptina,ar0331";
		reg = <0x10>;
		clock-names = "xclk";
		clocks = <&clk_ext_camera>;
		clock-frequency = <24000000>;
		vana-supply = <&cam1_2v7_supply>;
		vdig-supply = <&cam1_1v2_supply>;
		vif-supply = <&cam1_1v8_supply>;
		
		enable-gpios = <&pinctrl RZV2H_GPIO(6, 0) GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pinctrl RZV2H_GPIO(9, 3) GPIO_ACTIVE_LOW>;

		port {
			ar_to_csi23: endpoint {
				clock-lanes = <0>;
				data-lanes = <1>;
				remote-endpoint = <&csi23_in>;
			};
		};
	};
	
	/delete-node/ ov5645_csi23@3c;
};

