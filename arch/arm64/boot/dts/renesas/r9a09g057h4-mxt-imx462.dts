		clocks = <&clk_ext_camera>;
		clock-frequency = <24000000>;
		VANA-supply = <&ov5645_vdda_2v8>;
		VDIG-supply = <&ov5645_vdddo_1v8>;
		VDDL-supply = <&ov5645_vddd_1v5>;
		
		enable-gpios = <&pinctrl RZV2H_GPIO(6, 1) GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pinctrl RZV2H_GPIO(9, 2) GPIO_ACTIVE_LOW>;

		port {
