				clock-noncontinuous;
				link-frequencies = /bits/ 64 <493500000>;
			};
		};
	};
	
	/delete-node/ ov5645_csi22@3c;
};

&i2c7 {
	pinctrl-0 = <&i2c7_pins>;
	pinctrl-names = "default";

	status = "okay";
	
	imx462_csi23: imx462_csi23@c {
		compatible = "arducam,arducam-pivariety";
		reg = <0x0C>;
		clock-names = "xclk";
		clocks = <&clk_ext_camera>;
		clock-frequency = <24000000>;
		VANA-supply = <&ov5645_vdda_2v8>;
		VDIG-supply = <&ov5645_vdddo_1v8>;
		VDDL-supply = <&ov5645_vddd_1v5>;
		
		enable-gpios = <&pinctrl RZV2H_GPIO(6, 0) GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pinctrl RZV2H_GPIO(9, 3) GPIO_ACTIVE_LOW>;

		port {
			imx_to_csi23: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2>;
				remote-endpoint = <&csi23_in>;
				clock-noncontinuous;
