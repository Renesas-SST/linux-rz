/dts-v1/;

#include "r9a07g044l2.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irqc-rzg2l.h>
#include <dt-bindings/pinctrl/rzg2l-pinctrl.h>

/ {
    /* Basic property board */
    model = "RS-G2L100 Board Kit (Ver 1.1) (Dual Cortex-A55)";
    compatible = "rs-g2l100", "renesas,r9a07g044l2-smarc", "renesas,r9a07g044l2";

    /* boot setup */
    chosen {
        bootargs = "ignore_loglevel rw root=/dev/nfs ip=on";
        stdout-path = "serial0:115200n8";
    };

    /* Aliases */
    aliases {
        serial0 = &scif0;
        serial2 = &scif2;
        serial4 = &scif4;
        i2c0 = &i2c0;
        i2c1 = &i2c1;
        i2c3 = &i2c3;
        ethernet0 = &eth0;
        ethernet1 = &eth1;
        mmc0 = &sdhi0;
        mmc1 = &sdhi1;
    };

    /* memory */
    memory@48000000 {
        device_type = "memory";
        /* Reserve 128MB for secure area */
        reg = <0x0 0x48000000 0x0 0xF8000000>;  /* 4GB - 128MB */
    };

    reserved-memory {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;

        global_cma: linux,cma@58000000 {
            compatible = "shared-dma-pool";
            linux,cma-default;
            reusable;
            reg = <0x0 0x58000000 0x0 0x10000000>;
        };

        mmp_reserved: linux,multimedia {
            compatible = "shared-dma-pool";
            reusable;
            reg = <0x0 0x68000000 0x0 0x8000000>;
        };
    };

    /* Clock */
    x1: x1-clock {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <24000000>;
    };

    x2: x2-clock {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <32768>;
    };

    osc1: cec-clock {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <12000000>;
    };

    /* Regulator */
    reg_1p1v: regulator-vdd-core {
        compatible = "regulator-fixed";
        regulator-name = "fixed-1.1V";
        regulator-min-microvolt = <1100000>;
        regulator-max-microvolt = <1100000>;
        regulator-boot-on;
        regulator-always-on;
    };

    regulator-usb0-vbus-otg {
        compatible = "regulator-fixed";
        regulator-name = "USB0_VBUS_OTG";
        regulator-min-microvolt = <5000000>;
        regulator-max-microvolt = <5000000>;
    };

    reg_1p8v: regulator-1p8v {
        compatible = "regulator-fixed";
        regulator-name = "fixed-1.8V";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        regulator-boot-on;
        regulator-always-on;
    };

    reg_3p3v: regulator-3p3v {
        compatible = "regulator-fixed";
        regulator-name = "fixed-3.3V";
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        regulator-boot-on;
        regulator-always-on;
    };

    vccq_sdhi0: regulator-vccq-sdhi0 {
        compatible = "regulator-gpio";
        regulator-name = "SDHI0 VccQ";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <3300000>;
        states = <3300000 1>, <1800000 0>;
        regulator-boot-on;
        gpios = <&pinctrl RZG2L_GPIO(39, 0) GPIO_ACTIVE_HIGH>;
        regulator-always-on;
    };

    vccq_sdhi1: regulator-vccq-sdhi1 {
        compatible = "regulator-gpio";
        regulator-name = "SDHI1 VccQ";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <3300000>;
        gpios-states = <1>;
        gpios = <&pinctrl RZG2L_GPIO(39, 2) GPIO_ACTIVE_HIGH>;
        states = <3300000 1>, <1800000 0>;
    };

    /* Audio */
    snd_rzg2l: sound {
        compatible = "simple-audio-card";

        ssi_link: simple-audio-card,dai-link@0 {
            format = "i2s";
            bitclock-master = <&cpu_dai0>;
            frame-master = <&cpu_dai0>;
            mclk-fs = <256>;

            cpu_dai0: cpu {
                sound-dai = <&ssi0>;
            };

            codec {
                sound-dai = <&da7212>;
                clocks = <&versa3 1>;
            };
        };
    };

    sound_card {
        compatible = "audio-graph-card";
        label = "HDMI-Audio";
        dais = <&i2s1_port>;
    };

    /* Video/Display */
    hdmi-out {
        compatible = "hdmi-connector";
        type = "a";

        port {
            hdmi_con_out: endpoint {
                remote-endpoint = <&adv7535_out>;
            };
        };
    };

    /* Multimedia */
    mmngr {
        compatible = "renesas,mmngr";
        memory-region = <&mmp_reserved>;
    };

    mmngrbuf {
        compatible = "renesas,mmngrbuf";
    };

    vspm_if {
        compatible = "renesas,vspm_if";
    };
};

/* Pinctrl Configuration - Grouped by Function */
&pinctrl {
    adc_pins: adc {
        pinmux = <RZG2L_PORT_PINMUX(9, 0, 2)>; /* ADC_TRG */
    };

    /* Serial Communication */
    scif0_pins: scif0 {
        pinmux = <RZG2L_PORT_PINMUX(38, 0, 1)>, /* TxD */
             <RZG2L_PORT_PINMUX(38, 1, 1)>;    /* RxD */
    };

    scif2_pins: scif2 {
        pinmux = <RZG2L_PORT_PINMUX(48, 0, 1)>, /* TxD */
             <RZG2L_PORT_PINMUX(48, 1, 1)>, /* RxD */
             <RZG2L_PORT_PINMUX(48, 3, 1)>, /* CTS# */
             <RZG2L_PORT_PINMUX(48, 4, 1)>; /* RTS# */
    };

    scif4_pins: scif4 {
        pinmux = <RZG2L_PORT_PINMUX(2, 0, 5)>, /* TxD */
             <RZG2L_PORT_PINMUX(2, 1, 5)>; /* RxD */
    };

    /* I2C */
    i2c0_pins: i2c0 {
        pins = "RIIC0_SDA", "RIIC0_SCL";
        input-enable;
    };

    i2c1_pins: i2c1 {
        pins = "RIIC1_SDA", "RIIC1_SCL";
        input-enable;
    };

    i2c3_pins: i2c3 {
        pinmux = <RZG2L_PORT_PINMUX(18, 0, 3)>, /* SDA */
             <RZG2L_PORT_PINMUX(18, 1, 3)>; /* SCL */
    };

    /* SPI */
    spi1_pins: spi1 {
        pinmux = <RZG2L_PORT_PINMUX(44, 0, 1)>, /* CK */
             <RZG2L_PORT_PINMUX(44, 1, 1)>, /* MOSI */
             <RZG2L_PORT_PINMUX(44, 2, 1)>, /* MISO */
             <RZG2L_PORT_PINMUX(44, 3, 1)>; /* SSL */
    };

    qspi0_pins: qspi0 {
        qspi0-data {
            pins = "QSPI0_IO0", "QSPI0_IO1", "QSPI0_IO2", "QSPI0_IO3";
            power-source = <1800>;
        };
        qspi0-ctrl {
            pins = "QSPI0_SPCLK", "QSPI0_SSL", "QSPI_RESET#";
            power-source = <1800>;
        };
    };

    /* Ethernet */
    eth0_pins: eth0 {
        pinmux = <RZG2L_PORT_PINMUX(20, 0, 1)>, /* ET0_TXC */
             <RZG2L_PORT_PINMUX(20, 1, 1)>, /* ET0_TX_CTL */
             <RZG2L_PORT_PINMUX(20, 2, 1)>, /* ET0_TXD0 */
             <RZG2L_PORT_PINMUX(21, 0, 1)>, /* ET0_TXD1 */
             <RZG2L_PORT_PINMUX(21, 1, 1)>, /* ET0_TXD2 */
             <RZG2L_PORT_PINMUX(22, 0, 1)>, /* ET0_TXD3 */
             <RZG2L_PORT_PINMUX(22, 1, 1)>, /* ET0_TX_ERR */
             <RZG2L_PORT_PINMUX(23, 0, 1)>, /* ET0_TXD3 */
             <RZG2L_PORT_PINMUX(23, 1, 1)>, /* ET0_TX_ERR */
             <RZG2L_PORT_PINMUX(24, 0, 1)>, /* ET0_RXC */
             <RZG2L_PORT_PINMUX(24, 1, 1)>, /* ET0_RX_CTL */
             <RZG2L_PORT_PINMUX(25, 0, 1)>, /* ET0_RXD0 */
             <RZG2L_PORT_PINMUX(25, 1, 1)>, /* ET0_RXD1 */
             <RZG2L_PORT_PINMUX(26, 0, 1)>, /* ET0_RXD2 */
             <RZG2L_PORT_PINMUX(26, 1, 1)>, /* ET0_RXD3 */
             <RZG2L_PORT_PINMUX(27, 0, 1)>, /* ET0_RX_ERR */
             <RZG2L_PORT_PINMUX(27, 1, 1)>, /* ET0_MDC */
             <RZG2L_PORT_PINMUX(28, 0, 1)>, /* ET0_MDIO */
             <RZG2L_PORT_PINMUX(28, 1, 1)>, /* ET0_LINKSTA */
             <RZG2L_PORT_PINMUX(1, 0, 1)>;  /* IRQ0 */
    };

    eth1_pins: eth1 {
        groups = "eth1_link", "eth1_mdio", "eth1_mii";
        function = "eth1";
        pinmux = <RZG2L_PORT_PINMUX(29, 0, 1)>, /* ET1_TXC */
             <RZG2L_PORT_PINMUX(29, 1, 1)>, /* ET1_TX_CTL */
             <RZG2L_PORT_PINMUX(30, 0, 1)>, /* ET1_TXD0 */
             <RZG2L_PORT_PINMUX(30, 1, 1)>, /* ET1_TXD1 */
             <RZG2L_PORT_PINMUX(31, 0, 1)>, /* ET1_TXD2 */
             <RZG2L_PORT_PINMUX(31, 1, 1)>, /* ET1_TXD3 */
             <RZG2L_PORT_PINMUX(32, 0, 1)>, /* ET1_TX_ERR */
             <RZG2L_PORT_PINMUX(32, 1, 1)>, /* ET1_TX_COL */
             <RZG2L_PORT_PINMUX(33, 0, 1)>, /* ET1_TX_CRS */
             <RZG2L_PORT_PINMUX(33, 1, 1)>, /* ET1_RXC */
             <RZG2L_PORT_PINMUX(34, 0, 1)>, /* ET1_RX_CTL */
             <RZG2L_PORT_PINMUX(34, 1, 1)>, /* ET1_RXD0 */
             <RZG2L_PORT_PINMUX(35, 0, 1)>, /* ET1_RXD1 */
             <RZG2L_PORT_PINMUX(35, 1, 1)>, /* ET1_RXD2 */
             <RZG2L_PORT_PINMUX(36, 0, 1)>, /* ET1_RXD3 */
             <RZG2L_PORT_PINMUX(36, 1, 1)>, /* ET1_RX_ER */
             <RZG2L_PORT_PINMUX(37, 0, 1)>, /* ET1_MDC */
             <RZG2L_PORT_PINMUX(37, 1, 1)>, /* ET1_MDIO */
             <RZG2L_PORT_PINMUX(37, 2, 1)>, /* ET1_LINKSTA */
             <RZG2L_PORT_PINMUX(1, 1, 1)>;  /* IRQ1 */
    };

    /* Audio */
    ssi0_pins: ssi0 {
        pinmux = <RZG2L_PORT_PINMUX(45, 0, 1)>, /* BCK */
             <RZG2L_PORT_PINMUX(45, 1, 1)>, /* RCK */
             <RZG2L_PORT_PINMUX(45, 2, 1)>, /* TXD */
             <RZG2L_PORT_PINMUX(45, 3, 1)>; /* RXD */
    };

    ssi1_pins: ssi1 {
        pinmux = <RZG2L_PORT_PINMUX(46, 0, 1)>, /* BCK */
             <RZG2L_PORT_PINMUX(46, 1, 1)>, /* RCK */
             <RZG2L_PORT_PINMUX(46, 2, 1)>, /* TXD */
             <RZG2L_PORT_PINMUX(46, 3, 1)>; /* RXD */
    };

    sound_clk_pins: sound_clk {
        pins = "AUDIO_CLK1", "AUDIO_CLK2";
        input-enable;
    };

    /* CAN */
    can0_pins: can0 {
        pinmux = <RZG2L_PORT_PINMUX(10, 1, 2)>, /* TX */
             <RZG2L_PORT_PINMUX(11, 0, 2)>; /* RX */
    };

    can1_pins: can1 {
        pinmux = <RZG2L_PORT_PINMUX(40, 0, 3)>, /* TX */
             <RZG2L_PORT_PINMUX(40, 1, 3)>; /* RX */
    };

    /* Timer/PWM */
    mtu3_pins: mtu3 {
        mtu3-ext-clk-input-pin {
            pinmux = <RZG2L_PORT_PINMUX(48, 0, 4)>, /* MTCLKA */
                 <RZG2L_PORT_PINMUX(48, 1, 4)>; /* MTCLKB */
        };
        mtu3-pwm {
            pinmux = <RZG2L_PORT_PINMUX(44, 0, 4)>, /* MTIOC3A */
                 <RZG2L_PORT_PINMUX(44, 1, 4)>, /* MTIOC3B */
                 <RZG2L_PORT_PINMUX(44, 2, 4)>, /* MTIOC3C */
                 <RZG2L_PORT_PINMUX(44, 3, 4)>; /* MTIOC3D */
        };
    };

    gpt4_pins: gpt4 {
        pinmux = <RZG2L_PORT_PINMUX(43, 0, 2)>, /* Channel A */
             <RZG2L_PORT_PINMUX(43, 1, 2)>; /* Channel B */
    };

    /* GPIO Hog Controls */
    can0-stb-hog {
        gpio-hog;
        gpios = <RZG2L_GPIO(42, 2) GPIO_ACTIVE_HIGH>;
        output-low;
        line-name = "can0_stb";
    };

    can1-stb-hog {
        gpio-hog;
        gpios = <RZG2L_GPIO(42, 3) GPIO_ACTIVE_HIGH>;
        output-low;
        line-name = "can1_stb";
    };

    dsi_sw_sel {
        gpio-hog;
        gpios = <RZG2L_GPIO(4, 1) GPIO_ACTIVE_HIGH>;
        output-low;
        line-name = "dsi_sw_sel";
        status = "okay";
    };

};

/* Audio Configuration */
&audio_clk1 {
    clock-frequency = <11289600>;
};

&audio_clk2 {
    clock-frequency = <12288000>;
};

&cpu_dai0 {
    sound-dai = <&ssi0>;
};

&ssi0 {
    pinctrl-0 = <&ssi0_pins &sound_clk_pins>;
    pinctrl-names = "default";
    status = "okay";
};

&ssi1 {
    pinctrl-0 = <&ssi1_pins>;
    pinctrl-names = "default";
    status = "okay";

    i2s1_port: port {
        i2s1_cpu_endpoint: endpoint {
            remote-endpoint = <&codec_endpoint>;
            dai-format = "i2s";
            bitclock-master = <&i2s1_cpu_endpoint>;
            frame-master = <&i2s1_cpu_endpoint>;
        };
    };
};

&i2c3 {
    pinctrl-0 = <&i2c3_pins>;
    pinctrl-names = "default";
    clock-frequency = <400000>;
    status = "okay";

    da7212: codec@1a {
        compatible = "dlg,da7212";
        #sound-dai-cells = <0>;
        reg = <0x1a>;
        status = "disabled";

        /* Power supplies */
        VDDA-supply = <&reg_1p8v>;
        VDDSP-supply = <&reg_1p8v>;
        VDDMIC-supply = <&reg_1p8v>;
        VDDIO-supply = <&reg_1p8v>;

        /* Clock configuration */
        clocks = <&versa3 1>;
        clock-names = "mclk";

        /* DA7212 specific configuration */
        dlg,micbias1-lvl = <2500>; /* 2.5V */
        dlg,micbias2-lvl = <2500>;
        dlg,dmic-data-sel = "lrise_rfall";
        dlg,dmic-samplephase = "between_clkedge";
        dlg,dmic-clkrate = <3000000>;

    };


    versa3: clock-generator@68 {
        compatible = "renesas,5p35023";
        reg = <0x68>;
        #clock-cells = <1>;
        clocks = <&x1>;

        renesas,settings = [
            80 00 11 19 4c 02 23 7f 83 19 08 a9 5f 25 24 bf
            00 14 7a e1 00 00 00 00 01 55 59 bb 3f 30 90 b6
            80 b0 45 c4 95
        ];

        assigned-clocks = <&versa3 0>, <&versa3 1>,
                  <&versa3 2>, <&versa3 3>,
                  <&versa3 4>, <&versa3 5>;
        assigned-clock-rates = <24000000>, <11289600>,
                       <11289600>, <12000000>,
                       <25000000>, <12288000>;
    };
};

/* Video/Display Configuration */
&du {
    status = "okay";

    ports {
        #address-cells = <1>;
        #size-cells = <0>;

        port@0 {
            reg = <0>;
            du_out_rgb: endpoint {
            };
        };

        port@1 {
            reg = <1>;
        };
    };
};

&dsi {
    status = "okay";
    ports {
        port@0 {
            reg = <0>;
        };

        port@1 {
            dsi0_out: endpoint {
                data-lanes = <1 2 3 4>;
                remote-endpoint = <&adv7535_in>;
            };
        };
    };
};

&i2c1 {
    pinctrl-0 = <&i2c1_pins>;
    pinctrl-names = "default";
    status = "okay";

    adv7535: hdmi@3d {
        compatible = "adi,adv7535";
        reg = <0x3d>;

        avdd-supply = <&reg_1p8v>;
        dvdd-supply = <&reg_1p8v>;
        pvdd-supply = <&reg_1p8v>;
        a2vdd-supply = <&reg_1p8v>;
        v3p3-supply = <&reg_3p3v>;
        v1p2-supply = <&reg_1p8v>;

        interrupt-parent = <&pinctrl>;
        interrupts = <RZG2L_GPIO(13, 2) IRQ_TYPE_EDGE_FALLING>;

        adi,dsi-lanes = <4>;
        #sound-dai-cells = <0>;

        ports {
            #address-cells = <1>;
            #size-cells = <0>;

            port@0 {
                reg = <0>;
                adv7535_in: endpoint {
                    remote-endpoint = <&dsi0_out>;
                };
            };

            port@1 {
                reg = <1>;
                adv7535_out: endpoint {
                    remote-endpoint = <&hdmi_con_out>;
                };
            };

            port@2 {
                reg = <2>;
                codec_endpoint: endpoint {
                    remote-endpoint = <&i2s1_cpu_endpoint>;
                };
            };
        };
    };
};

/* Ethernet Configuration */
&eth0 {
    pinctrl-0 = <&eth0_pins>;
    pinctrl-names = "default";
    phy-handle = <&phy0>;
    phy-mode = "rgmii";
    status = "okay";

    phy0: ethernet-phy@7 {
        compatible = "ethernet-phy-id0022.1640",
                 "ethernet-phy-ieee802.3-c22";
        reg = <4>;
        interrupt-parent = <&irqc>;
        interrupts = <RZG2L_IRQ2 IRQ_TYPE_LEVEL_LOW>;
        rxc-skew-psec = <2400>;
        txc-skew-psec = <2400>;
        rxdv-skew-psec = <0>;
        txen-skew-psec = <0>;
        rxd0-skew-psec = <0>;
        rxd1-skew-psec = <0>;
        rxd2-skew-psec = <0>;
        rxd3-skew-psec = <0>;
        txd0-skew-psec = <0>;
        txd1-skew-psec = <0>;
        txd2-skew-psec = <0>;
        txd3-skew-psec = <0>;
    };
};

&eth1 {
    pinctrl-0 = <&eth1_pins>;
    pinctrl-names = "default";
    phy-handle = <&phy1>;
    phy-mode = "rgmii";
    status = "okay";

    phy1: ethernet-phy@7 {
        compatible = "ethernet-phy-id0022.1640",
                 "ethernet-phy-ieee802.3-c22";
        reg = <7>;
        interrupt-parent = <&irqc>;
        interrupts = <RZG2L_IRQ3 IRQ_TYPE_LEVEL_LOW>;
        rxc-skew-psec = <2400>;
        txc-skew-psec = <2400>;
        rxdv-skew-psec = <0>;
        txen-skew-psec = <0>;
        rxd0-skew-psec = <0>;
        rxd1-skew-psec = <0>;
        rxd2-skew-psec = <0>;
        rxd3-skew-psec = <0>;
        txd0-skew-psec = <0>;
        txd1-skew-psec = <0>;
        txd2-skew-psec = <0>;
        txd3-skew-psec = <0>;
    };
};

/* Flash Memory Configuration */
&spi {
    pinctrl-0 = <&qspi0_pins>;
    pinctrl-names = "default";
    status = "okay";

    flash@0 {
        compatible = "renesas,at25sf128a", "jedec,spi-nor";
        reg = <0>;
        m25p,fast-read;
        spi-max-frequency = <50000000>;
        spi-rx-bus-width = <4>;
        spi-tx-bus-width = <4>;

        partitions {
            compatible = "fixed-partitions";
            #address-cells = <1>;
            #size-cells = <1>;

            boot@0 {
                reg = <0x00000000 0x2000000>;
                read-only;
            };
            user@2000000 {
                reg = <0x2000000 0x2000000>;
            };
        };
    };
};

/* Serial Communication */
&scif0 {
    pinctrl-0 = <&scif0_pins>;
    pinctrl-names = "default";
    status = "okay";
};

&scif2 {
    pinctrl-0 = <&scif2_pins>;
    pinctrl-names = "default";
    status = "okay";
};

&scif4 {
    pinctrl-0 = <&scif4_pins>;
    pinctrl-names = "default";
    status = "okay";
};

/* CAN Configuration */
&canfd {
    pinctrl-0 = <&can0_pins>, <&can1_pins>;
    pinctrl-names = "default";
    status = "okay";

    /* Default set as Classical CAN(CAN 2.0) mode, remove to enable CAN FD mode */
    renesas,no-can-fd;

    /* CAN0 on */
    channel0 {
        status = "okay";
    };

    /* CAN1 on */
    channel1 {
        status = "okay";
    };
};

/* USB Configuration */
&ehci0 {
    memory-region = <&global_cma>;
    dr_mode = "otg";
    status = "okay";
};

&ohci0 {
    memory-region = <&global_cma>;
    dr_mode = "otg";
    status = "okay";
};

&ehci1 {
    memory-region = <&global_cma>;
    status = "okay";
};

&ohci1 {
    memory-region = <&global_cma>;
    status = "okay";
};

&hsusb {
    status = "okay";
};

&phyrst {
    status = "okay";
};

&usb2_phy0 {
    status = "okay";
};

&usb2_phy1 {
    status = "okay";
};

/* System Components */
&gpu {
    mali-supply = <&reg_1p1v>;
};

&wdt0 {
    status = "okay";
    timeout-sec = <60>;
};

&wdt1 {
    status = "okay";
    timeout-sec = <60>;
};

&ostm1 {
    status = "okay";
};

&ostm2 {
    status = "okay";
};

&extal_clk {
    clock-frequency = <24000000>;
};

/* Power Management */
&i2c3 {
    raa215300: pmic@12 {
        compatible = "renesas,raa215300";
        reg = <0x12>, <0x6f>;
        reg-names = "main", "rtc";
        clocks = <&x2>;
        clock-names = "xin";
    };
};

/* eMMC Configuration */
&pinctrl {
    /* Slot 0 emmc */
    sdhi0_emmc_pins: sd0emmc {
        sd0_emmc_data {
            pins = "SD0_DATA0", "SD0_DATA1", "SD0_DATA2", "SD0_DATA3",
                   "SD0_DATA4", "SD0_DATA5", "SD0_DATA6", "SD0_DATA7";
            power-source = <1800>;
        };
        sd0_emmc_ctrl {
            pins = "SD0_CLK", "SD0_CMD";
            power-source = <1800>;
        };
        sd0_emmc_rst {
            pins = "SD0_RST#";
            power-source = <1800>;
        };
    };
};

&sdhi0 {
    pinctrl-0 = <&sdhi0_emmc_pins>;
    pinctrl-1 = <&sdhi0_emmc_pins>;
    pinctrl-names = "default", "state_uhs";

    vmmc-supply = <&reg_3p3v>;
    vqmmc-supply = <&reg_1p8v>;
    bus-width = <8>;
    mmc-hs200-1_8v;
    non-removable;
    fixed-emmc-driver-type = <1>;
    status = "okay";
};

/* SD Card Configuration */
&pinctrl {
    /* Slot 1 sdcard */
    sdhi1_pins: sd1 {
        sd1_data {
            pins = "SD1_DATA0", "SD1_DATA1", "SD1_DATA2", "SD1_DATA3";
            power-source = <3300>;
        };
        sd1_ctrl {
            pins = "SD1_CLK", "SD1_CMD";
            power-source = <3300>;
        };
        sd1_mux {
            pinmux = <RZG2L_PORT_PINMUX(19, 0, 1)>;
        };
    };
};

&sdhi1 {
    pinctrl-0 = <&sdhi1_pins>;
    pinctrl-names = "default";

    vmmc-supply = <&reg_3p3v>;
    vqmmc-supply = <&reg_3p3v>;
    bus-width = <4>;
    status = "okay";

    no-1-8-v;
    no-mmc;
    non-removable;
    keep-power-in-suspend;
};

/* ADC */
&adc {
    pinctrl-0 = <&adc_pins>;
    pinctrl-names = "default";
    status = "okay";

    /delete-node/ channel@6;
    /delete-node/ channel@7;
};

